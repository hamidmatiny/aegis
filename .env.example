# AEGIS local development environment
# Copy to .env and adjust as needed

# Set this to pull a specific tagged release's prebuilt images from GHCR
# (ghcr.io/hamidmatiny/aegis-<service>:<tag>) instead of building from
# source. Used on resource-constrained deploy targets where compiling
# locally isn't practical -- see the comment above `services:` in
# docker-compose.yml. Leave unset to track :latest.
# AEGIS_IMAGE_TAG=v0.3.0

# Postgres
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev
POSTGRES_DB=aegis
DATABASE_URL=postgres://aegis:aegis_dev@postgres:5432/aegis?sslmode=disable

# Redis (not consumed by any service yet -- reserved for future
# rate-limiting/caching. Password is still generated and enforced on the
# redis container itself via docker-compose.yml's requirepass, so it
# isn't left open even while unused.)
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=

# Audit signing (Ed25519 — generate with: openssl genpkey -algorithm Ed25519 -out audit.key)
# Leave unset to use docker-compose dev default (stable across restarts). Empty string generates a new ephemeral key each restart.
AEGIS_AUDIT_URL=http://localhost:8084
# AEGIS_AUDIT_SIGNING_KEY=YWVnaXMtZGV2LWF1ZGl0LXNpZ25pbmcta2V5LXYxISE=

# SDK / gateway reverse-proxy (OpenAI-compatible entry on port 8080)
AEGIS_INPUT_DEFENSE_URL=http://localhost:8090
AEGIS_OUTPUT_DEFENSE_URL=http://localhost:8091
AEGIS_POLICY_ENGINE_URL=http://localhost:8081
AEGIS_MODEL_ROUTER_URL=http://localhost:8082
AEGIS_AGENT_GATE_URL=http://localhost:8083
# OPENAI_BASE_URL=http://localhost:8080/v1
AEGIS_AUDIT_SIGNING_KEY_ID=dev-key-1

# Service ports (host mapping)
GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=9080
POLICY_ENGINE_PORT=8081
MODEL_ROUTER_PORT=8082
AGENT_GATE_PORT=8083
AUDIT_PORT=8084
DASHBOARD_PORT=3000
INPUT_DEFENSE_PORT=8090
OUTPUT_DEFENSE_PORT=8091
REDTEAM_PORT=8092

# Dashboard (HTTP basic auth) and gateway API keys — there is no static
# default credential. Run `./scripts/generate-credentials.sh` to fill these
# in with fresh random values; if left unset, the dashboard and gateway will
# each generate a one-time credential at container startup and log it once
# (it changes on every restart until you persist one here).
AEGIS_DASHBOARD_USER=admin
# AEGIS_DASHBOARD_PASSWORD=
# AEGIS_API_KEYS=

# Agent-gate: two SEPARATE credentials. The service key is for calling
# agents/integrations submitting tool calls; the reviewer key is required
# to approve or deny a pending approval and must never equal the service
# key — that separation is what makes "human approval required" real
# instead of something the calling agent can satisfy itself. The dashboard
# container needs both (it proxies the Approval Inbox) and must be set to
# the SAME values as agent-gate's. Also filled in by generate-credentials.sh.
# AEGIS_AGENT_GATE_API_KEYS=
# AEGIS_AGENT_GATE_REVIEWER_KEYS=

# Shared internal service-to-service token. policy-engine, audit,
# input-defense, output-defense, and model-router all refuse to start
# without this set — they used to be reachable with no auth at all to
# anything on the Docker network. Every process that calls them (gateway,
# agent-gate, redteam, the dashboard's nginx proxy, the SDK's embedded
# DefensePipeline) needs this SAME value, not a separate one per service.
# Filled in by generate-credentials.sh.
# AEGIS_INTERNAL_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-gateway
LOG_LEVEL=info

# LLM providers (used by model-router — injected via docker-compose env_file, NOT baked into images)
# Set each key exactly once here. Do NOT export these in your shell; shell env overrides .env for compose.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Output-defense backends (compose defaults: toxicity=stub, pii=regex, backtranslation=router)
AEGIS_OUTPUT_DEFENSE_BACKTRANSLATION_BACKEND=router
AEGIS_OUTPUT_DEFENSE_BACKTRANSLATION_PROVIDER=grok
AEGIS_OUTPUT_DEFENSE_BACKTRANSLATION_MODEL=grok-4.3
AEGIS_OUTPUT_DEFENSE_JUDGE_PROVIDER=grok
AEGIS_OUTPUT_DEFENSE_JUDGE_MODEL=grok-4.3
AEGIS_REDTEAM_INPUT_DEFENSE_URL=http://localhost:8090
AEGIS_REDTEAM_OUTPUT_DEFENSE_URL=http://localhost:8091
AEGIS_REDTEAM_DETECTION_THRESHOLD=0.50

# Agent gate
AEGIS_POLICY_ENGINE_URL=http://localhost:8081
AEGIS_APPROVAL_TTL_HOURS=24

# Policy
AEGIS_DEFAULT_POLICY_PACK=default
AEGIS_POLICY_DIR=/etc/aegis/policies
