# Dependencies
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
# .env.enc is SOPS-encrypted ciphertext (Stage B.1) -- safe to commit,
# it's the actual point of having it. See .sops.yaml.
!.env.enc

# Stage D.3: postgres backups. The plain .sql.gz dump is raw audit/attack
# data, never committed. Its .sql.gz.enc counterpart is SOPS-encrypted
# ciphertext -- same safe-to-commit reasoning as .env.enc above.
backups/*.sql.gz
!backups/*.sql.gz.enc
backups/backup.log

# Go
bin/
dist/
*.exe
*.test
*.out
vendor/

# Generated protobuf (keep shared/gen/go/go.mod + placeholder.go in git)
shared/gen/python/
shared/gen/go/aegis/
*.pb.go
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi

# Build artifacts
build/
*.egg-info/
.eggs/
*.whl
coverage/
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Docker volumes (local)
.docker-data/

# Secrets and keys (never commit)
*.pem
*.key
secrets/

# Dashboard
dashboard/dist/
dashboard/.next/

# Benchmark results (local)
benchmark-results/

# Helm
deploy/helm/charts/*.tgz

# Rendered demo nginx config contains a real API key (see deploy/oracle/setup.sh)
deploy/oracle/nginx-demo.conf
deploy/oracle/nginx-demo-canary.conf

# Stray debug/temp artifacts from local script runs (e.g. generate-canary-nginx.sh
# iteration) that should never be committed -- see the leftover-files cleanup
# after the Stage 2 Phase 2 canary generator work.
deploy/oracle/tmp_*
deploy/oracle/sh-thd-*

# Stage B.1 follow-up: age private keys must never be committed
age-key.txt
*.agekey

# Stage C.1: Cloudflare Origin CA cert pair (deploy/oracle/tls/origin.pem,
# deploy/oracle/tls/origin-key.pem) -- already covered by the *.pem / *.key
# rules above, called out explicitly here since this is private-key
# material and "already covered by an unrelated-looking rule" is exactly
# the kind of thing worth spelling out rather than leaving implicit.
.pytest_policy_tenants/
