#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE="docker compose -f $ROOT/docker-compose.yml"

echo "==> Waiting for services to be healthy..."
$COMPOSE ps

echo "==> Running integration smoke tests..."

# Local dev convenience: pick up the same credentials used to start the
# stack from .env if they aren't already in the environment. CI sets these
# explicitly (no .env file exists in a fresh CI checkout), so this is a
# no-op there.
if [[ -f "$ROOT/.env" && ( -z "${AEGIS_DASHBOARD_PASSWORD:-}" || -z "${AEGIS_API_KEYS:-}" ) ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

: "${AEGIS_DASHBOARD_USER:?AEGIS_DASHBOARD_USER must be set — run scripts/generate-credentials.sh, or export it, before running this script}"
: "${AEGIS_DASHBOARD_PASSWORD:?AEGIS_DASHBOARD_PASSWORD must be set for integration tests}"
: "${AEGIS_API_KEYS:?AEGIS_API_KEYS must be set for integration tests}"
: "${AEGIS_AGENT_GATE_API_KEYS:?AEGIS_AGENT_GATE_API_KEYS must be set for integration tests}"
: "${AEGIS_AGENT_GATE_REVIEWER_KEYS:?AEGIS_AGENT_GATE_REVIEWER_KEYS must be set for integration tests}"

# AEGIS_API_KEYS may be a comma-separated list; use the first for smoke tests.
API_KEY="${AEGIS_API_KEYS%%,*}"
AGENT_GATE_KEY="${AEGIS_AGENT_GATE_API_KEYS%%,*}"
AGENT_GATE_REVIEWER_KEY="${AEGIS_AGENT_GATE_REVIEWER_KEYS%%,*}"

# Stage 0: verify health endpoints respond
services=(
  "http://localhost:8080/health|gateway"
  "http://localhost:8081/health|policy-engine"
  "http://localhost:8082/health|model-router"
  "http://localhost:8083/health|agent-gate"
  "http://localhost:8084/health|audit"
  "http://localhost:8090/health|input-defense"
  "http://localhost:8091/health|output-defense"
  "http://localhost:8092/health|redteam"
  "http://localhost:3000/|dashboard"
)

for entry in "${services[@]}"; do
  url="${entry%%|*}"
  name="${entry##*|}"
  echo "  Checking $name at $url"
  if [[ "$name" == "dashboard" ]]; then
    curl -sf -u "${AEGIS_DASHBOARD_USER}:${AEGIS_DASHBOARD_PASSWORD}" "$url" > /dev/null || { echo "FAIL: $name"; exit 1; }
  else
    # /health and /ready are always exempt from gateway API-key auth.
    curl -sf "$url" > /dev/null || { echo "FAIL: $name"; exit 1; }
  fi
done

echo "==> Dashboard rejects wrong credentials..."
status="$(curl -s -o /dev/null -w '%{http_code}' -u "${AEGIS_DASHBOARD_USER}:wrong-password" http://localhost:3000/)"
[[ "$status" == "401" ]] || { echo "FAIL: dashboard accepted a wrong password (got $status)"; exit 1; }

echo "==> Policy engine input evaluation smoke test..."
curl -sf -X POST http://localhost:8081/v1/evaluate/input \
  -H 'Content-Type: application/json' \
  -d '{"tenant_id":"default","input_verdict":{"action":"BLOCK","fused_score":0.92,"detector_scores":[{"detector_id":"heuristic","score":0.92,"reasoning":"test"}]}}' \
  | grep -q '"action":"block"' || { echo "FAIL: policy-engine evaluate/input"; exit 1; }

echo "==> Model router chat completion smoke test..."
curl -sf -X POST http://localhost:8082/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -d '{"messages":[{"role":"user","content":"Hello"}]}' \
  | grep -q '"object":"chat.completion"' || { echo "FAIL: model-router chat/completions"; exit 1; }

echo "==> Gateway rejects requests with no API key..."
status="$(curl -s -o /dev/null -w '%{http_code}' -X POST http://localhost:8080/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -d '{"model":"mock-model","messages":[{"role":"user","content":"Hello"}]}')"
[[ "$status" == "401" ]] || { echo "FAIL: gateway allowed an unauthenticated request (got $status)"; exit 1; }

echo "==> Gateway rejects requests with a wrong API key..."
status="$(curl -s -o /dev/null -w '%{http_code}' -X POST http://localhost:8080/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -H 'Authorization: Bearer not-the-right-key' \
  -d '{"model":"mock-model","messages":[{"role":"user","content":"Hello"}]}')"
[[ "$status" == "401" ]] || { echo "FAIL: gateway allowed a wrong API key (got $status)"; exit 1; }

echo "==> Go gateway defended chat smoke test (valid API key)..."
curl -sf -X POST http://localhost:8080/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -H "Authorization: Bearer ${API_KEY}" \
  -d '{"model":"mock-model","messages":[{"role":"user","content":"Hello"}]}' \
  | grep -q '"object":"chat.completion"' || { echo "FAIL: gateway chat/completions with valid key"; exit 1; }

echo "==> Agent-gate rejects unauthenticated evaluate..."
status="$(curl -s -o /dev/null -w '%{http_code}' -X POST http://localhost:8083/v1/evaluate \
  -H 'Content-Type: application/json' \
  -d '{"tenant_id":"default","tool_call":{"tool_name":"search_docs","risk_level":"LOW"}}')"
[[ "$status" == "401" ]] || { echo "FAIL: agent-gate allowed an unauthenticated evaluate (got $status)"; exit 1; }

echo "==> Agent-gate catalog overrides an understated risk_level for a registered tool..."
approval_id="$(curl -sf -X POST http://localhost:8083/v1/evaluate \
  -H 'Content-Type: application/json' \
  -H "Authorization: Bearer ${AGENT_GATE_KEY}" \
  -d '{"tenant_id":"default","tool_call":{"tool_name":"delete_database","risk_level":"LOW","arguments":[{"name":"db_id","value":"prod-1"}]}}' \
  | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["decision"].get("approval_request_id",""))')"
[[ -n "$approval_id" ]] || { echo "FAIL: delete_database claimed as LOW risk was not escalated for approval — tool_catalog override is not working"; exit 1; }

echo "==> Agent-gate rejects deciding an approval with only the service key..."
status="$(curl -s -o /dev/null -w '%{http_code}' -X POST "http://localhost:8083/v1/approvals/${approval_id}/decide" \
  -H 'Content-Type: application/json' \
  -H "Authorization: Bearer ${AGENT_GATE_KEY}" \
  -d '{"approved":true,"reviewer_id":"integration-test"}')"
[[ "$status" == "401" ]] || { echo "FAIL: agent-gate let the service key self-approve (got $status) — a calling agent must not be able to approve its own action"; exit 1; }

echo "==> Agent-gate accepts deciding an approval with the reviewer key..."
curl -sf -X POST "http://localhost:8083/v1/approvals/${approval_id}/decide" \
  -H 'Content-Type: application/json' \
  -H "Authorization: Bearer ${AGENT_GATE_REVIEWER_KEY}" \
  -d '{"approved":true,"reviewer_id":"integration-test"}' \
  | grep -q '"status":"APPROVED"' || { echo "FAIL: agent-gate did not approve with a valid reviewer key"; exit 1; }

echo "==> Verifying custom services run as non-root (container hardening)..."
hardened_services=(gateway policy-engine model-router agent-gate audit input-defense output-defense redteam dashboard)
for svc in "${hardened_services[@]}"; do
  uid="$($COMPOSE exec -T "$svc" id -u 2>/dev/null || true)"
  if [[ -z "$uid" || "$uid" == "0" ]]; then
    echo "FAIL: $svc is running as root (uid=${uid:-unknown}) — container hardening regression"
    exit 1
  fi
done

echo "==> All integration smoke tests passed"
