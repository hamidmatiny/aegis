# Public demo reverse proxy. Sits in front of the gateway and:
#  1. Injects the real AEGIS_API_KEYS server-side, so public visitors never
#     see or need a key — the demo "just works" with plain curl/browser.
#  2. Rate-limits per source IP so the free-tier demo can't be hammered.
#  3. Only exposes /health and the defended chat endpoint — nothing else.
#
# ${AEGIS_DEMO_API_KEY} is substituted by deploy/oracle/setup.sh via envsubst
# at container start; it is never committed to the repo.

limit_req_zone $binary_remote_addr zone=aegis_demo:10m rate=6r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        proxy_pass http://gateway:8080/health;
    }

    location = /v1/chat/completions {
        limit_req zone=aegis_demo burst=3 nodelay;
        limit_req_status 429;

        proxy_set_header Authorization "Bearer ${AEGIS_DEMO_API_KEY}";
        proxy_set_header Content-Type "application/json";
        proxy_pass http://gateway:8080/v1/chat/completions;
    }

    # Static demo webpage (deploy/oracle/demo-web/index.html) — everything
    # else 404s, this proxy intentionally exposes nothing beyond the page
    # and the two routes above.
    location / {
        try_files $uri $uri/ =404;
    }
}
